<?xml version="1.0" encoding="utf-8"?>
<!-- The app's look (see Theme.java): dark wood screens and parchment
     dialogs with brass and gold. -->
<resources>
    <style name="FreeCol" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF2A1D12</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FFE3C27A</item>
        <item name="android:colorPrimary">#FF2A1D12</item>
        <item name="android:alertDialogTheme">@style/FreeCol.Dialog</item>
    </style>

    <!-- Every pop-up (choices, confirmations, lists) on parchment. -->
    <style name="FreeCol.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_paper</item>
        <item name="android:colorBackground">#FFE9DCBC</item>
        <item name="android:colorAccent">#FF7A5A2C</item>
        <item name="android:textColorPrimary">#FF3A2A18</item>
        <item name="android:textColorSecondary">#FF6B5232</item>
        <item name="android:windowTitleStyle">@style/FreeCol.DialogTitle</item>
    </style>

    <style name="FreeCol.DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF3A2A18</item>
    </style>
</resources>
